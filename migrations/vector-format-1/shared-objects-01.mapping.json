{
  "description": "Where every value of the pre-migration SHARED-OBJECTS-TEST-VECTORS-01.json lives in lfcp-vector-format/1. Read by scripts/check-vector-migration.mjs.",
  "suite_file": "test-vectors/shared-objects-01/SHARED-OBJECTS-TEST-VECTORS-01.json",
  "baseline_commit": "8f1cc79785775abca39111f44c3d052ab66d6ccb",
  "moves": [
    ["suite", "suite.id"],
    ["profile", "suite.specification.profile"],
