    ["deterministic_vectors[id=*].input", "cases[id=$1].inputs.object_id"],
    ["deterministic_vectors[id=*].input_hex", "cases[id=$1].inputs.principal_id.hex"],
    ["deterministic_vectors[id=*].expected_hex", "cases[id=$1].expected.actor_id.hex"],
    ["deterministic_vectors[id=*].expected", "cases[id=$1].expected.principal_ref"],
    ["deterministic_vectors[id=*].automerge_change_hex", "cases[id=$1].inputs.automerge_change_hex.hex"],
    ["deterministic_vectors[id=*].automerge_save_hex", "cases[id=$1].inputs.automerge_save_hex.hex"],
    ["deterministic_vectors[id=*].expected_cbor_hex", "cases[id=$1].expected.framed_cbor.hex"],
    ["deterministic_vectors[id=*].expected_sha256", "cases[id=$1].expected.sha256.hex"],
    ["deterministic_vectors[id=*].expected_valid", "cases[id=$1].expected.valid"],
    ["deterministic_vectors[id=*].error", "cases[id=$1].expected.error.code"],

    ["behavioral_scenarios[id=*].id", "cases[id=$1].id"],
    ["behavioral_scenarios[id=*].title", "cases[id=$1].description"],
    ["behavioral_scenarios[id=*].notes", "cases[id=$1].note"],
    ["behavioral_scenarios[id=*].base_state", "cases[id=$1].inputs.base_state"],
    ["behavioral_scenarios[id=*].branches", "cases[id=$1].inputs.branches"],
    ["behavioral_scenarios[id=*].expected", "cases[id=$1].expected"],
    ["behavioral_scenarios[id=*].assertions", "cases[id=$1].assertions"],

    ["invalid_cases[id=*].id", "cases[id=$1].id"],
    ["invalid_cases[id=*].mutation", "cases[id=$1].inputs.mutation"],
    ["invalid_cases[id=*].expected", "cases[id=$1].expected.error.code"],
    ["invalid_cases[id=*].diagnostic", "cases[id=$1].expected.error.diagnostic"]
  ],
  "changed": [
    { "path": "deterministic_vectors[id=D07-uuid-invalid-uppercase].error", "from": "INVALID_OBJECT_ID", "to": "PROFILE_INVALID", "rule": "SPEC-PATCH-01 / G3: profile failures use code PROFILE_INVALID; INVALID_OBJECT_ID moves to the diagnostic." },
    { "path": "deterministic_vectors[id=D08-uuid-invalid-version].error", "from": "INVALID_OBJECT_ID", "to": "PROFILE_INVALID", "rule": "SPEC-PATCH-01 / G3: profile failures use code PROFILE_INVALID; INVALID_OBJECT_ID moves to the diagnostic." }
  ],
  "structural": [
    { "path": "deterministic_vectors[id=*].deterministic_bytes", "value": true, "rule": "Encoded by the case type: bytes for D01-D05; validation (exact accept/reject) for D06-D08." }
  ],
  "added": [
    { "path": "format", "rule": "Vector format identifier." },
    { "path": "suite.version", "rule": "Suite version, taken from the -01 suffix of the suite ID." },
    { "path": "suite.specification.id", "rule": "The specification document the profile identifier belongs to." },
    { "path": "suite.specification.revision", "rule": "SHARED-OBJECTS-PROFILE-01 is a Working Draft." },
    { "path": "suite.description", "rule": "Prose summary of the suite." },
    { "path": "cases[*].type", "rule": "Case type: bytes (D01-D05), validation (D06-D08, I01-I07), behavioral (S01-S14)." },
    { "path": "cases[*].kind", "rule": "Kind for old sections without one: shared_object_scenario (S01-S14), profile_validation (I01-I07)." },
    { "path": "cases[*].expected.valid", "value": false, "rule": "Every old invalid_cases entry describes a profile-invalid state." },
    { "path": "cases[id=D07-uuid-invalid-uppercase].expected.error.diagnostic", "value": "INVALID_OBJECT_ID", "rule": "SPEC-PATCH-01 / G3: the former top-level code becomes the diagnostic." },
    { "path": "cases[id=D08-uuid-invalid-version].expected.error.diagnostic", "value": "INVALID_OBJECT_ID", "rule": "SPEC-PATCH-01 / G3: the former top-level code becomes the diagnostic." }
  ]
}
