    ["transfers.nonce", "cases[id=owner_transfer].inputs.nonce.hex"],
    ["transfers.*", "cases[id=owner_transfer].expected.$1.hex"],

    ["key_packages.*.hpke_ephemeral_private", "cases[id=$1].expected.hpke_ephemeral_private.hex"],
    ["key_packages.*.*", "cases[id=$1].expected.$2.hex"],

