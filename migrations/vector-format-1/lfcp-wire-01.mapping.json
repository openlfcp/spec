  "added": [
    { "path": "format", "rule": "Vector format identifier." },
    { "path": "suite.version", "rule": "Suite version, taken from the -01 suffix of the suite ID." },
    { "path": "suite.specification.revision", "rule": "LFCP-WIRE-01 is a Working Draft." },
    { "path": "suite.description", "rule": "Prose summary of the suite." },
    { "path": "cases[*].id", "rule": "Case ID, taken from the old object key (principal_<key> for principals; dek_commitments, owner_transfer, invite_uri, actor_equivocation, tampered_D1, stale_epoch for single-object sections)." },
    { "path": "cases[*].type", "rule": "Case type: bytes for every old positive section, validation for every old negative entry." },
    { "path": "cases[*].kind", "rule": "Case kind, named after the old top-level section." },
    { "path": "cases[*].expected.valid", "value": false, "rule": "Every old negative entry describes an object that must be rejected." },
    { "path": "cases[id=actor_equivocation].expected.error.code", "value": "ACTOR_EQUIVOCATION", "rule": "LFCP-WIRE-01 section 62 error code 16; LFCP-TEST-VECTORS-01.md section 17.3 names this expected result." },
    { "path": "cases[id=stale_epoch].expected.error.code", "value": "STALE_DATA_EPOCH", "rule": "LFCP-WIRE-01 section 62 error code 14; the old free-text value starts with this code and is kept verbatim in error.detail." },
    { "path": "cases[id=dek_commitments].inputs.dek0_epoch", "value": 0, "rule": "Added after the migration by LFCP-008 (spec gap S1): explicit epoch input for the LFCP-WIRE-01 section 11 commitment. A new input, not a changed value." },
    { "path": "cases[id=dek_commitments].inputs.dek1_epoch", "value": 1, "rule": "Added after the migration by LFCP-008 (spec gap S1): explicit epoch input for the LFCP-WIRE-01 section 11 commitment. A new input, not a changed value." },
    { "path": "cases[id=tampered_D1].expected.error.code", "value": "INVALID_SIGNATURE", "rule": "SPEC-PATCH-01 / G1: the project owner assigned INVALID_SIGNATURE (LFCP-WIRE-01 section 10.5, section 62 code 7) to this rejection, which had no code." },
    { "path": "cases[id=*].inputs.hpke_ephemeral_ikm.hex", "rule": "SPEC-PATCH-03 / G-KP2: HPKE ephemeral input keying material ikmE; skE = DeriveKeyPair(ikmE)." }
  ]
}
